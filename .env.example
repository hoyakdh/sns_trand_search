# Apify API token (https://console.apify.com/account/integrations)
APIFY_TOKEN=

# OpenAI API key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Set to "true" to use mock data instead of Apify (useful for development)
USE_MOCK_DATA=true

# Max posts/reels to analyze per account (default: 50)
ANALYSIS_LIMIT=50

# Max following accounts to analyze (default: 100)
FOLLOWING_LIMIT=100

# Cache TTL in hours (default: 24)
CACHE_TTL_HOURS=24
